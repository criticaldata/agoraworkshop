# Required for live runs. The canonical configs pin an OpenAI model.
# Not needed for the mock-provider smoke config.
OPENAI_API_KEY=

# Optional: point the OpenAI adapter at a compatible gateway or proxy.
# OPENAI_BASE_URL=

# Only needed if a config sets model.provider to anthropic.
# ANTHROPIC_API_KEY=

# Where the SQLite database lives. On Railway, point this at a mounted volume.
AGORA_DATA_DIR=./data

# Where export bundles are written.
AGORA_EXPORT_DIR=./exports

# Where the server looks for frozen configs.
AGORA_CONFIG_DIR=./configs

# HTTP port (Railway sets this automatically).
PORT=3000

# Shared credential for the deployed instance.
#
# Starting a run spends money, so run-starting and export routes always require this.
# If it is unset, those routes are REFUSED with a 503 rather than served openly: a
# forgotten variable makes the instance read-only, not free to use.
AGORA_AUTH_PASSWORD=

# `write` (default) protects only run-starting and export; reading stays open so the
# overview and documentation can be shared. `all` puts every route except the health
# check behind the credential.
AGORA_AUTH_SCOPE=write

# Shown in the browser's credential prompt.
AGORA_AUTH_REALM=AGORA
