# Required for live runs. The canonical configs pin an OpenAI model.
# Not needed for the mock-provider smoke config.
OPENAI_API_KEY=

# Optional: point the OpenAI adapter at a compatible gateway or proxy.
# OPENAI_BASE_URL=

# Only needed if a config sets model.provider to anthropic.
# ANTHROPIC_API_KEY=

# Where the SQLite database lives. On Railway, point this at a mounted volume.
AGORA_DATA_DIR=./data

# Where export bundles are written.
AGORA_EXPORT_DIR=./exports

# Where the server looks for frozen configs.
AGORA_CONFIG_DIR=./configs

# HTTP port (Railway sets this automatically).
PORT=3000
